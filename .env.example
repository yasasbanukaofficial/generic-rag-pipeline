# ---------------------------------------------------------------------------
# OpenAI-compatible provider (used for BOTH embeddings and chat completion)
# Works with OpenAI, OpenRouter, Groq, Together AI, or a local OpenAI-compatible
# server (Ollama / vLLM). Use the matching key, base URL and model IDs.
# Example OpenAI base URL: https://api.openai.com/v1
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_API_URL=https://openrouter.ai/api/v1

# Embedding model: turns documents and the user query into vectors
EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-8b:free

# Chat/instruction model: writes the final answer from the retrieved context
AI_MODEL=inclusionai/ling-3.2-flash:free

# ---------------------------------------------------------------------------
# ChromaDB
# Default storage is LOCAL at db/chroma_db. Only CHROMA_COLLECTION_NAME is
# actually used by the local setup, but config.py reads every variable at
# import time with os.environ[...], so ALL keys below must exist in .env.
# Empty/dummy values are fine for local use. Fill in the three cloud values
# only if you uncomment the ChromaDB Cloud blocks in vectorstore.py.
# ---------------------------------------------------------------------------
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
CHROMA_COLLECTION_NAME=battlex_data

